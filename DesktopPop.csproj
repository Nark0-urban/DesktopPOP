<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>DesktopPop</AssemblyName>
    <RootNamespace>DesktopPop</RootNamespace>
    <StartupObject>DesktopPop.App</StartupObject>
    <Product>DesktopPop</Product>
    <Company>DesktopPop</Company>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.1.6</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- 기본 가방 그림 (그림 파일로 들어 있는 것들) -->
    <EmbeddedResource Include="Assets\kafka.png" LogicalName="DesktopPop.Assets.kafka.png" />
  </ItemGroup>

</Project>
